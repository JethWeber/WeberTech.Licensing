<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WeberTech.LicenseGenerator.App"
             RequestedThemeVariant="Dark">

  <!-- Design system Cyber-Shield Enterprise (Fase 6, M1) -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://WeberTech.LicenseGenerator/Styles/DesignTokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <!-- FluentTheme primeiro: Styles.axaml vem depois para conseguir
         sobrepor os defaults onde os seletores baterem (botões, TextBox). -->
    <FluentTheme />
    <StyleInclude Source="avares://WeberTech.LicenseGenerator/Styles/Styles.axaml" />
  </Application.Styles>

</Application>
