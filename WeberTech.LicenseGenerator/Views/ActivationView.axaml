<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:WeberTech.LicenseGenerator.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="700" d:DesignHeight="600"
             x:Class="WeberTech.LicenseGenerator.Views.ActivationView"
             x:DataType="vm:ActivationViewModel">

  <Design.DataContext>
    <vm:ActivationViewModel />
  </Design.DataContext>

  <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
      <TextBlock Text="Passo 1 — Ler o pedido de ativação" FontSize="20" FontWeight="Bold" />
      <TextBlock Text="Cola o texto Base64 recebido por WhatsApp/email, ou o texto completo do QR Code (formato WTAREQ1:...)."
                 TextWrapping="Wrap" Opacity="0.75" />
    </StackPanel>

    <TextBox Grid.Row="1"
             Text="{Binding QrText}"
             Watermark="WTAREQ1:eyJmbXQiOiJXVEFSRVExIiwi..."
             AcceptsReturn="True"
             TextWrapping="Wrap"
             Height="120"
             FontFamily="Consolas,Menlo,monospace" />

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
      <Button Content="Interpretar pedido" Command="{Binding ParseQrTextCommand}" Classes="accent" />
      <Button Content="Limpar" Command="{Binding ClearCommand}" />
    </StackPanel>

    <TextBlock Grid.Row="3"
               Text="{Binding ErrorMessage}"
               Foreground="Crimson"
               TextWrapping="Wrap"
               Margin="0,12,0,0"
               IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <Border Grid.Row="4"
            IsVisible="{Binding ParsedRequest, Converter={x:Static ObjectConverters.IsNotNull}}"
            BorderBrush="Gray" BorderThickness="1" CornerRadius="6"
            Padding="16" Margin="0,16,0,0">
      <StackPanel Spacing="8">
        <TextBlock Text="Pedido interpretado com sucesso" FontWeight="Bold" />

        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Produto:" Opacity="0.7" />
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ParsedRequest.ProductId}" FontFamily="Consolas,Menlo,monospace" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Machine ID:" Opacity="0.7" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ParsedRequest.MachineId}" FontFamily="Consolas,Menlo,monospace" />

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Request ID:" Opacity="0.7" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ParsedRequest.RequestId}" FontFamily="Consolas,Menlo,monospace" />

          <TextBlock Grid.Row="3" Grid.Column="0" Text="Pedido em:" Opacity="0.7" />
          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ParsedRequest.RequestedAt}" FontFamily="Consolas,Menlo,monospace" />
        </Grid>
      </StackPanel>
    </Border>

    <Button Grid.Row="5"
            Content="Continuar →"
            Command="{Binding ContinueCommand}"
            HorizontalAlignment="Right"
            Margin="0,16,0,0"
            Classes="accent" />

  </Grid>
</UserControl>
