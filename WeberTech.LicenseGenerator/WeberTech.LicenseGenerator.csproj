<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WeberTech.LicenseGenerator</RootNamespace>
    <AssemblyName>WeberTech.LicenseGenerator</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!--
      Dev em Linux (Mint), destino de execução real é Windows (WMI, Fase 3).
      RuntimeIdentifiers pré-declarados para permitir cross-publish direto
      a partir do Linux, sem precisar de uma máquina Windows para compilar:
        dotnet publish -c Release -r win-x64 -p:SelfContained=true
      O .NET SDK descarrega os runtime packs win-x64 automaticamente no
      restore. Não precisas instalar mais nada manualmente para isto.
    -->
    <RuntimeIdentifiers>win-x64;win-x86</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.1" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.1" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.1" Condition="'$(Configuration)' == 'Debug'" />

    <!-- MVVM: [ObservableProperty]/[RelayCommand] via source generators, evita boilerplate de INotifyPropertyChanged/ICommand em cada ViewModel -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />

    <!-- Leitura de QR Code via webcam/imagem (Fase 6) -->
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
    <PackageReference Include="ZXing.Net.Bindings.SkiaSharp" Version="0.16.13" />

    <!-- Historico local de licencas emitidas (Fase 6 / HistoryView) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.0" />

    <!--
      Necessário para a ferramenta `dotnet ef` (migrations) conseguir
      introspectar o GeneratorDbContext. PrivateAssets=all — não é preciso
      em runtime, só durante `dotnet ef migrations add`.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WeberTech.Licensing\WeberTech.Licensing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

</Project>
